Vagrant.configure("2") do |conf|
    conf.vm.box =  "debian/bookworm64"
    conf.vm.define "hsaktiwyS" do |control|
        control.vm.hostname = "hsaktiwyS"
        control.vm.network "private_network", ip: "192.168.56.110"
        control.vm.provider "virtualbox" do |vb|
            vb.memory = "2048"
            vb.cpus = 2
        end
        control.vm.provision "shell", inline: <<-SHELL
            sudo apt-get update && sudo apt-get install curl -y
            
            # Install K3s server
            curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="--node-ip 192.168.56.110 --bind-address 192.168.56.110" sh -
            
            # Setup Kubeconfig for the vagrant user
            mkdir -p /home/vagrant/.kube
            cp /etc/rancher/k3s/k3s.yaml /home/vagrant/.kube/config
            chown -R vagrant:vagrant /home/vagrant/.kube
            echo "export KUBECONFIG=/home/vagrant/.kube/config" >> /home/vagrant/.bashrc
            kubectl apply -f /vagrant/confs/deployment.yml
        SHELL
    end
end
